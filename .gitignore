.build/
.swiftpm/
build/

# kagami — same rule as shikki's projects/shikki/.gitignore:
#   scopes.toml is the auto-generated scope CACHE (regenerable via `kagami auto-discover --write-cache`),
#   never committed (a committed cache goes stale — obyw-one/CoreKit#21 review);
#   only the operator-authored .kagami/scopes.override.toml is tracked config.
.kagami/scopes.toml
.kagami/scopes.yaml
.kagami/tmp/
# kagami SQLite scratch — history/shard DBs are local test state, never committed
.kagami/history.db
.kagami/history.db-shm
.kagami/history.db-wal
.kagami/history.db.write-lock
.kagami/tmp/

# graphify skill output dump — generated, not source
graphify-out/

# shield / gate run reports — local run artefacts
reports/

# moto architecture cache dir (the .moto marker itself IS tracked; the cache dir is not)
.moto-cache/
